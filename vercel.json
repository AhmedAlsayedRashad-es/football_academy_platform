{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist/public",
  "installCommand": "npm install",
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/login.js": {
      "maxDuration": 30
    },
    "api/[...path].js": {
      "includeFiles": "dist/**",
      "maxDuration": 60
    }
  }
}
