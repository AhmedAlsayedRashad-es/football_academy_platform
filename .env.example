# Core runtime
NODE_ENV=development
PORT=3000

# Database (required)
DATABASE_URL=mysql://user:password@host:3306/football_academy_platform?ssl-mode=REQUIRED

# App identity and auth
VITE_APP_ID=football-academy-local
JWT_SECRET=change-me
OWNER_OPEN_ID=

# Leave empty in local dev to skip OAuth server integration
OAUTH_SERVER_URL=
VITE_OAUTH_PORTAL_URL=

# AI / Gemini API
GEMINI_API_KEY=
BUILT_IN_FORGE_API_KEY=
BUILT_IN_FORGE_API_URL=
VITE_FRONTEND_FORGE_API_URL=
VITE_FRONTEND_FORGE_API_KEY=

# WebAuthn
RP_ID=localhost
ORIGIN=http://localhost:3000

# Stripe (optional)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MONTHLY_PRICE_ID=
STRIPE_QUARTERLY_PRICE_ID=
STRIPE_ANNUAL_PRICE_ID=

# Push notifications
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VITE_VAPID_PUBLIC_KEY=

# PlayerMaker integration (optional)
PLAYERMAKER_CLIENT_KEY=
PLAYERMAKER_CLIENT_SECRET=
PLAYERMAKER_TEAM_ID=
PLAYERMAKER_TEAM_CODE=

# Video and external analysis APIs (optional)
TWELVELABS_API_KEY=
FOOTBALL_DATA_API_KEY=
VITE_API_FOOTBALL_KEY=

# Messaging and billing display (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
VITE_ACADEMY_WHATSAPP=
VITE_FAWRY_CODE=
VITE_INSTAPAY_HANDLE=
